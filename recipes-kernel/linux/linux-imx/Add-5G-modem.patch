From 18f32f3e8cb2b2c2927ceb2dfe59bfd1984379f3 Mon Sep 17 00:00:00 2001
From: Florin Leotescu <florin.leotescu@nxp.com>
Date: Mon, 13 Oct 2025 13:43:48 +0300
Subject: [PATCH v2 2/2] LF-16410-2: arm64: dts: imx943 - Add 5G modem
Content-Type: text/plain; charset="iso-8859-1"

Add 5G modem

Signed-off-by: Qiang Li <qiang.li@nxp.com>
Signed-off-by: Florin Leotescu <florin.leotescu@nxp.com>
---
 arch/arm64/boot/dts/freescale/Makefile        |  1 +
 .../freescale/imx943-orangebox-5G-modem.dts   | 86 +++++++++++++++++++
 2 files changed, 87 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx943-orangebox-5G-modem.dts

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 0bf63f8fff03..a377871de19b 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -610,6 +610,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx943-evk-netc-rpmsg.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx943-orangebox.dtb
 imx943-orangebox-mic-dtbs := imx943-orangebox.dtb imx943-orangebox-mic.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx943-orangebox-mic.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx943-orangebox-5G-modem.dtb
 
 dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-evk.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-evk-flexspi-m2.dtb
diff --git a/arch/arm64/boot/dts/freescale/imx943-orangebox-5G-modem.dts b/arch/arm64/boot/dts/freescale/imx943-orangebox-5G-modem.dts
new file mode 100644
index 000000000000..1933e2383e21
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx943-orangebox-5G-modem.dts
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2025 NXP
+ */
+
+#include <dt-bindings/phy/phy-imx8-pcie.h>
+#include "imx943-orangebox.dts"
+
+/ {
+	mdm_wake: mdm-wake {
+		compatible = "gpio-keys";
+		mdm_wowwan {
+			label = "Modem Wakeup";
+			gpios = <&gpio5 26 GPIO_ACTIVE_HIGH>;
+			linux,code = <KEY_WAKEUP>;
+			wakeup-source;
+			debounce-interval = <0>;
+			interrupt-parent = <&gpio5>;
+			interrupts = <26 IRQ_TYPE_EDGE_FALLING>;
+		};
+	};
+};
+
+&ptn5150 {
+	status = "disabled";
+	/delete-node/ connector;
+};
+
+&usb3_dwc3 {
+	/delete-property/ extcon;
+	dr_mode = "host";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mdm_wowwan>;
+};
+
+&usb3_phy {
+	orientation-switch;
+	status = "okay";
+	/delete-node/ port;
+};
+
+&pcal6524 {
+	usb3-mdm-sel-usb-hog {
+		status = "disabled";
+	};
+
+	usb3-mdm-sel-mdm-hog {
+		gpio-hog;
+		gpios = <9 GPIO_ACTIVE_HIGH>;
+		output-low;
+	};
+
+	mdm_reset_b {
+		gpio-hog;
+		gpios = <1 GPIO_ACTIVE_HIGH>;
+		output-high;
+	};
+
+	mdm_power_off{
+		gpio-hog;
+		gpios = <7 GPIO_ACTIVE_HIGH>;
+		output-high;
+	};
+
+	mdm_w_disable{
+		gpio-hog;
+		gpios = <8 GPIO_ACTIVE_HIGH>;
+		output-high;
+	};
+
+	mdm_perst{
+		gpio-hog;
+		gpios = <23 GPIO_ACTIVE_HIGH>;
+		output-high;
+	};
+};
+
+&netc_switch {
+	status = "disabled";
+};
+
+&scmi_iomuxc {
+	mdm_wowwan: wwan {
+		fsl,pins = <IMX94_PAD_ETH1_RXD3__GPIO5_IO26		0x31e>;
+	};
+};
-- 
