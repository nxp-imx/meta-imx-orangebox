From fab9dfaf10e7e8be5075addafe62100aeda5760c Mon Sep 17 00:00:00 2001
From: ZihengXu <ziheng.xu@nxp.com>
Date: Fri, 24 Oct 2025 12:34:17 +0900
Subject: [PATCH 2/5] OB-385: add orangebox-qtm.dts and update soc-utils.c to
 enable dtb match

Signed-off-by: ZihengXu <ziheng.xu@nxp.com>

Upstream-Status: Pending

---
 arch/arm64/boot/dts/freescale/Makefile        |  1 +
 .../dts/freescale/imx943-orangebox-qtm.dts    | 87 +++++++++++++++++++
 sound/soc/soc-utils.c                         |  7 ++
 3 files changed, 95 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx943-orangebox-qtm.dts

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 0bf63f8fff03..c6e5d2e3972f 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -610,6 +610,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx943-evk-netc-rpmsg.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx943-orangebox.dtb
 imx943-orangebox-mic-dtbs := imx943-orangebox.dtb imx943-orangebox-mic.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx943-orangebox-mic.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx943-orangebox-qtm.dtb
 
 dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-evk.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-evk-flexspi-m2.dtb
diff --git a/arch/arm64/boot/dts/freescale/imx943-orangebox-qtm.dts b/arch/arm64/boot/dts/freescale/imx943-orangebox-qtm.dts
new file mode 100644
index 000000000000..24134824aaa1
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx943-orangebox-qtm.dts
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2024-2025 NXP
+ */
+
+/dts-v1/;
+
+#include "imx943-orangebox.dts"
+
+/ {
+	dummy_radio_codec: dummy_radio_codec {
+		#sound-dai-cells = <0>;
+		compatible = "linux,snd-soc-dummy";
+		// num-channels = <2>;
+    };
+
+    sound-radio {
+        compatible = "simple-audio-card";
+        simple-audio-card,name = "radio-dummy";
+        simple-audio-card,format = "i2s";
+        simple-audio-card,sound-dai = <&sai1>;
+        simple-audio-card,cpu {
+            sound-dai = <&sai1>;
+        };
+        simple-audio-card,codec {
+            sound-dai = <&dummy_radio_codec>;
+        };
+    };
+};
+
+&mqs1 {
+    status = "disabled";
+};
+
+&lpspi8 {
+	cs-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
+	num-cs = <1>;
+	pinctrl-0 = <&pinctrl_lpspi8>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	spidev1: spi@0 {
+		compatible = "rohm,dh2228fv";
+		reg = <0>;
+		spi-max-frequency = <12000000>;
+	};
+};
+
+&sai1 {
+	#sound-dai-cells = <0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_sai1>;
+	assigned-clocks = <&scmi_clk IMX94_CLK_AUDIOPLL1_VCO>,
+			<&scmi_clk IMX94_CLK_AUDIOPLL2_VCO>,
+			<&scmi_clk IMX94_CLK_AUDIOPLL1>,
+			<&scmi_clk IMX94_CLK_AUDIOPLL2>,
+			<&scmi_clk IMX94_CLK_SAI1>;
+	assigned-clock-parents = <0>, <0>, <0>, <0>,
+			<&scmi_clk IMX94_CLK_AUDIOPLL1>;
+	assigned-clock-rates = <3932160000>,
+			<3612672000>, <393216000>,
+			<361267200>, <24576000>;
+	fsl,sai-mclk-direction-output;
+	status = "okay";
+};
+
+&scmi_iomuxc {
+	pinctrl_lpspi8: lpspi8grp {
+		fsl,pins = <
+			IMX94_PAD_GPIO_IO12__GPIO2_IO12			0x3fe
+			IMX94_PAD_GPIO_IO13__LPSPI8_SIN			0x3fe
+			IMX94_PAD_GPIO_IO14__LPSPI8_SOUT		0x3fe
+			IMX94_PAD_GPIO_IO15__LPSPI8_SCK			0x3fe
+		>;
+	};
+
+	pinctrl_sai1: sai1grp {
+		fsl,pins = <
+			IMX94_PAD_SAI1_RXD0__SAI1_MCLK				0x31e
+			IMX94_PAD_SAI1_TXC__SAI1_TX_BCLK			0x31e
+			IMX94_PAD_SAI1_TXFS__SAI1_TX_SYNC			0x31e
+			IMX94_PAD_SAI1_RXD0__SAI1_RX_DATA0			0x31e
+			IMX94_PAD_SAI1_TXD0__SAI1_TX_DATA0 			0x31e
+		>;
+	};
+
+};
\ No newline at end of file
diff --git a/sound/soc/soc-utils.c b/sound/soc/soc-utils.c
index 303823dc45d7..c884de805325 100644
--- a/sound/soc/soc-utils.c
+++ b/sound/soc/soc-utils.c
@@ -21,6 +21,12 @@ int snd_soc_calc_frame_size(int sample_size, int channels, int tdm_slots)
 }
 EXPORT_SYMBOL_GPL(snd_soc_calc_frame_size);
 
+static const struct of_device_id soc_dummy_ids[] = {
+	{ .compatible = "linux,snd-soc-dummy", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, soc_dummy_ids);
+
 int snd_soc_params_to_frame_size(const struct snd_pcm_hw_params *params)
 {
 	int sample_size;
@@ -253,6 +259,7 @@ static int snd_soc_dummy_probe(struct platform_device *pdev)
 static struct platform_driver soc_dummy_driver = {
 	.driver = {
 		.name = "snd-soc-dummy",
+		.of_match_table = of_match_ptr(soc_dummy_ids),
 	},
 	.probe = snd_soc_dummy_probe,
 };
-- 
