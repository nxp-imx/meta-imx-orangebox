From 537431037356d73cc3f3a408daacc2bc489f0866 Mon Sep 17 00:00:00 2001
From: Qiang Li <qiang.li@nxp.com>
Date: Wed, 29 Oct 2025 11:21:24 +0900
Subject: [PATCH 5/5] LF-16409: arm64: dts: imx943: Enable GNSS module

Enable UART and I2C communication.

Signed-off-by: Simona Toaca <simona.toaca@nxp.com>
Signed-off-by: Florin Leotescu <florin.leotescu@nxp.com>
Reviewed-by: Peng Fan <peng.fan@nxp.com>

Upstream-Status: Pending

---
 .../boot/dts/freescale/imx943-orangebox.dts   | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx943-orangebox.dts b/arch/arm64/boot/dts/freescale/imx943-orangebox.dts
index 6dc625165231..cf3a85781c14 100644
--- a/arch/arm64/boot/dts/freescale/imx943-orangebox.dts
+++ b/arch/arm64/boot/dts/freescale/imx943-orangebox.dts
@@ -467,6 +467,13 @@ &lpi2c4 {
 	pinctrl-0 = <&pinctrl_lpi2c4>;
 	pinctrl-names = "default";
 	status = "okay";
+
+	gnss@42 {
+		reg = <0x42>;
+		pinctrl-0 = <&pinctrl_gnss>;
+		pinctrl-names = "default";
+		status = "okay";
+	};
 };
 
 &lpi2c6 {
@@ -514,6 +521,20 @@ &lpuart5 {
 	status = "okay";
 };
 
+&lpuart4 {
+	/* GNSS UART1 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart4>;
+	status = "okay";
+};
+
+&lpuart7 {
+	/* GNSS UART2 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart7>;
+	status = "okay";
+};
+
 &lpuart6 {
 	/* BT */
 	pinctrl-0 = <&pinctrl_uart6>;
@@ -916,6 +937,18 @@ IMX94_PAD_ETH1_TX_ER__GPIO5_IO29	0x31e	/* can2_en */
 		>;
 	};
 
+	pinctrl_gnss: gnssgrp {
+		fsl,pins = <
+			IMX94_PAD_ETH0_TXD1__GPIO5_IO1		0x57e // gnss_tx_ready
+			IMX94_PAD_ETH0_TX_EN__GPIO5_IO2		0x57e // gnss_ext_int
+			IMX94_PAD_ETH0_TXD3__GPIO5_IO8		0x57e // gnss_wheeltick
+			IMX94_PAD_ETH0_TXD2__GPIO5_IO7		0x57e // gnss_wake_up
+			IMX94_PAD_ETH0_TX_CLK__GPIO5_IO3	0x5fe // gnss_rtk_stat
+			IMX94_PAD_ETH0_CRS__GPIO5_IO14		0x57e // gnss_dir
+			IMX94_PAD_ETH1_RXD1__GPIO5_IO21		0x57e // cfg_mux_gnss_pps_sel
+		>;
+	};
+
 	pinctrl_flexcan4: flexcan4grp {
 		fsl,pins = <
 			IMX94_PAD_GPIO_IO36__CAN4_TX		0x39e
@@ -1048,6 +1081,13 @@ IMX94_PAD_GPIO_IO01__LPUART5_RX		0x31e
 		>;
 	};
 
+	pinctrl_uart4: uart4grp {
+		fsl,pins = <
+			IMX94_PAD_GPIO_IO40__LPUART4_TX		0x31e
+			IMX94_PAD_GPIO_IO41__LPUART4_RX		0x31e
+		>;
+	};
+
 	pinctrl_uart6: uart6grp {
 		fsl,pins = <
 			IMX94_PAD_GPIO_IO04__LPUART6_TX		0x31e
@@ -1057,6 +1097,13 @@ IMX94_PAD_GPIO_IO07__LPUART6_RTS_B	0x31e
 		>;
 	};
 
+	pinctrl_uart7: uart7grp {
+		fsl,pins = <
+			IMX94_PAD_GPIO_IO32__LPUART7_TX		0x31e
+			IMX94_PAD_GPIO_IO33__LPUART7_RX		0x31e
+		>;
+	};
+
 	pinctrl_usdhc1: usdhc1grp {
 		fsl,pins = <
 			IMX94_PAD_SD1_CLK__USDHC1_CLK		0x158e
-- 
2.34.1

