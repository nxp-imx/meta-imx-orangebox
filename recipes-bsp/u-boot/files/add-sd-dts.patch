+				SC_P_SNVS_TAMPER_IN0_LSIO_GPIO2_IO09_IN		0x06000021
+			>;
+		};
+
+		pinctrl_pcal6524_i2c0_x23: pcal6524i2c0x23grp {
+			fsl,pins = <
+				SC_P_SNVS_TAMPER_OUT4_LSIO_GPIO2_IO08_IN	0x06000021
+			>;
